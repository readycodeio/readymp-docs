{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../../../../wukong-csharp-mod/WukongMp.Sdk/bin/Debug/netstandard2.0",
          "files": [
            "ReadyM.Api.dll",
            "ReadyM.Api.Multiplayer.dll",
            "WukongMp.Api.dll",
            "WukongMp.Sdk.dll"
          ]
        },
        {
          "src": "../../../../embed-csharp-loader/HarmonyPrepatcher/src/PreludeLib/bin/Release/netstandard2.0",
          "files": [
            "PreludeLib.dll"
          ]
        }
      ],
      "output": "api",
      "filter": "filter.yml",
      "outputFormat": "markdown",
      "shouldSkipMarkup": true,
      "disableGitFeatures": true,
      "properties": {
        "TargetFramework": "netstandard2.0"
      },
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "WukongMP SDK",
      "_appTitle": "WukongMP SDK",
      "_enableSearch": false,
      "pdf": false
    },
    "xref": [
      "https://learn.microsoft.com/en-us/dotnet/.xrefmap.json"
    ]
  }
}